  "b_csep_quantile_convention": {
    "which_delta_is_reported": "delta_1",
    "the_0.094_is": "delta_1 of the CASCADE's pyCSEP catalog-based Number test (results/csep/pycsep_results.json -> models.cascade.Number.delta1 = 0.094; the companion delta2 = 0.908 is ALSO stored)",
    "pycsep_definition": "pyCSEP catalog_evaluations.number_test returns .quantile = (delta_1, delta_2) with delta_1 = P(X >= x_obs) and delta_2 = P(X <= x_obs) over the simulated catalogue counts.",
    "code_line_that_selects_it": {
      "file": "scripts/csep_run.py",
      "function": "pass_flag",
      "lines": "73-75",
      "verbatim": "if name.startswith(\"Number\"):\n    d = quantile if isinstance(quantile, (tuple, list)) else (quantile, 1 - quantile)\n    return bool(min(d[0], d[1]) > 0.025), {\"delta1\": round(float(d[0]), 4), \"delta2\": round(float(d[1]), 4)}",
      "reading": "d[0] = r.quantile[0] = pyCSEP delta_1 is stored under the key 'delta1'; d[1] = delta_2 under 'delta2'. BOTH are persisted; the PASS flag is two-sided, min(delta1,delta2) > 0.025 at alpha=0.05. The paper quotes delta_1."
    },
    "N_test_convention": "delta_1 = P(X >= x_obs). 0.094 means 9.4% of the cascade's simulated catalogues had >= 1383 events, i.e. the observation sits in the UPPER tail (the forecast under-counts). Consistent with delta2 = 0.908 and forecast mean 1305.772 < 1383 observed. delta1+delta2 = 1.002 != 1 exactly because both are inclusive at x_obs.",
    "M_S_PL_convention": {
      "code_line": "q = quantile[0] if isinstance(quantile,(tuple,list)) else quantile ; return bool(0.025 <= q <= 0.975), {\"gamma\": round(float(q),4)}",
      "statistic": "a single quantile score gamma stored under the key 'gamma' (NOT delta1/delta2)",
      "definition": "gamma = fraction of simulated catalogues whose test statistic is <= the observed statistic, i.e. gamma = P(S_sim <= S_obs)",
      "pass_rule": "two-sided, gamma in [0.025, 0.975] at alpha=0.05"
    },
    "values_as_stored": {
      "cascade_N_delta1": 0.094,
      "cascade_N_delta2": 0.908,
      "cascade_N_test_dist_mean": 1305.772,
      "cascade_N_pass": true,
      "cascade_M_gamma": 0.252,
      "cascade_S_gamma": 0.0,
      "cascade_PL_gamma": 0.0,
      "sv_etas_N_delta1": 0.08,
      "sv_etas_N_delta2": 0.922,
      "sv_etas_N_test_dist_mean": 1295.986,
      "hybrid_N_delta1": 0.0,
      "hybrid_N_delta2": 1.0,
      "hybrid_N_test_dist_mean": 1041.074,
      "hybrid_M_gamma": 0.61,
      "hybrid_S_gamma": 0.0,
      "hybrid_PL_gamma": 0.0,
      "n_observed": 1383,
      "n_cat": 500,
      "seed": 5000,
      "pycsep_version": "0.8.0"
    },
    "CORRECTION_to_the_task_premise": "The task described '0.61' as an 'S-test/pseudo-likelihood' value. It is NOT. 0.61 is the HYBRID's MAGNITUDE-test gamma (results/round3/hybrid_csep.json -> models.hybrid.Magnitude.gamma = 0.61), matching the paper: 'the hybrid stays magnitude-consistent (quantile 0.61)'. Every S-test and PL-test gamma stored for cascade, sv_etas, modern_etas and hybrid is 0.0 (all rejected). No stored artifact contains an S-test or PL quantile of 0.61.",
    "cross_check_note": "The in-house results/csep/csep_results.json (N_sim=1000, seed=42) gives DIFFERENT cascade values (delta1=0.013, N_forecast_mean=1304.1, M gamma=0.002, all FAIL). The paper's 0.094/0.25/1,306 come from the pyCSEP run, consistent with the paper's 'computed with the community pyCSEP toolkit'. pycsep_results.json.cross_check_vs_inhouse records agree_NM=false for cascade and sv_etas."
  },
